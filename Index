<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Reserva de Palco</title>
<style>
:root{--bg:#07111f;--panel:#101c2d;--line:#26364b;--text:#f7fafc;--muted:#91a4ba;--blue:#38bdf8;--booked:#fb7185;--ok:#34d399}*{box-sizing:border-box}body{margin:0;font-family:Inter,Segoe UI,Arial,sans-serif;background:linear-gradient(145deg,#07111f,#0c1830);color:var(--text);min-height:100vh}.wrap{max-width:1180px;margin:auto;padding:28px 18px}.hero,.card,.map{background:rgba(16,28,45,.94);border:1px solid var(--line);border-radius:24px;box-shadow:0 22px 60px #0005}.hero{padding:26px;margin-bottom:22px;background:linear-gradient(135deg,#0ea5e933,#4f46e522)}h1{margin:4px 0 8px;font-size:clamp(30px,5vw,48px)}.eyebrow{color:#7dd3fc;text-transform:uppercase;letter-spacing:.2em;font-weight:700;font-size:12px}.muted{color:var(--muted)}.layout{display:grid;grid-template-columns:350px 1fr;gap:22px}.card,.map{padding:24px}.field{margin:0 0 18px}label{display:block;font-size:13px;font-weight:700;margin-bottom:7px}input,select,textarea{width:100%;background:#081321;border:1px solid #33455d;color:white;border-radius:10px;padding:12px;font:inherit}textarea{min-height:100px;resize:vertical}.summary{padding:13px;background:#ffffff08;border:1px solid var(--line);border-radius:13px;font-size:14px;line-height:1.8}.btn{width:100%;border:0;border-radius:11px;background:var(--blue);color:#052235;padding:13px;font-weight:800;font-size:15px;cursor:pointer;margin-top:16px}.btn:hover{filter:brightness(1.08)}.msg{margin-top:13px;padding:11px;border-radius:10px;background:#f59e0b22;color:#fde68a;display:none}.msg.ok{background:#10b98122;color:#a7f3d0}.topline{display:flex;justify-content:space-between;gap:15px;align-items:center}.count{background:#ffffff0d;border-radius:14px;padding:10px 16px;text-align:center}.count b{display:block;font-size:28px;color:#7dd3fc}.legend{display:flex;gap:14px;flex-wrap:wrap;font-size:12px;color:var(--muted);margin:15px 0}.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:5px}.stage{max-width:650px;margin:30px auto 38px;border-top:4px solid #38bdf8aa;border-radius:50% 50% 0 0;text-align:center;padding:18px;color:#7dd3fc;text-transform:uppercase;letter-spacing:.3em;font-size:11px}.group-title{text-align:center;color:var(--muted);text-transform:uppercase;letter-spacing:.12em;font-size:12px;margin:18px}.seats{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;max-width:700px;margin:auto}.seats.standing{grid-template-columns:repeat(4,1fr);max-width:520px}.seat{min-height:92px;border-radius:16px;border:1px solid var(--line);background:#18283d;color:#dbeafe;cursor:pointer;font-weight:700;padding:10px}.seat:before{content:'▣';display:block;font-size:28px;margin-bottom:7px}.seat.selected{background:var(--blue);color:#062033;border-color:#bae6fd}.seat.booked{background:#fb718529;color:#fda4af;border-color:#fb718566;cursor:not-allowed}.divider{border:0;border-top:1px dashed var(--line);margin:32px 0}@media(max-width:800px){.layout{grid-template-columns:1fr}.seats{grid-template-columns:repeat(2,1fr)}.seats.standing{grid-template-columns:repeat(2,1fr)}}
</style>
</head><body><div class="wrap">
<section class="hero"><div class="eyebrow">Reserva de palco</div><h1>Elegí el evento y tu ubicación</h1><div class="muted">10 butacas y 4 ubicaciones separadas de pie. La disponibilidad se conserva por evento.</div></section>
<div class="layout"><aside class="card"><h2>Datos de la reserva</h2>
<div class="field"><label>Evento</label><select id="event"></select></div>
<div class="field"><label>Nombre del Ejecutivo</label><input id="executive" placeholder="Ej.: Nicolás Forti"></div>
<div class="field"><label>Persona/s acompañante/s</label><textarea id="companions" placeholder="Un nombre por línea o separados por coma"></textarea></div>
<div class="summary"><div>Asistentes: <b id="attendees">0</b></div><div>Ubicaciones seleccionadas: <b id="selectedCount">0</b></div></div>
<button class="btn" id="save">Guardar reserva</button><div class="msg" id="msg"></div></aside>
<section class="map"><div class="topline"><div><h2 id="eventName"></h2><span class="muted" id="eventDate"></span></div><div class="count"><b id="available">14</b><span class="muted">disponibles</span></div></div>
<div class="legend"><span><i class="dot" style="background:#334155"></i>Disponible</span><span><i class="dot" style="background:#38bdf8"></i>Seleccionada</span><span><i class="dot" style="background:#fb7185"></i>Reservada</span></div>
<div class="stage">Escenario</div><div class="group-title">Butacas sentadas</div><div class="seats" id="chairs"></div><hr class="divider"><div class="group-title">Ubicaciones separadas de pie</div><div class="seats standing" id="standing"></div></section></div></div>
<script>
const EVENTS=[{id:'evento-1',name:'Evento corporativo 1',date:'15/11/2026'},{id:'evento-2',name:'Evento corporativo 2',date:'22/11/2026'},{id:'evento-3',name:'Evento corporativo 3',date:'29/11/2026'}];
const SEATS=[...Array.from({length:10},(_,i)=>({id:`B${i+1}`,label:`Butaca ${i+1}`,type:'chair'})),...Array.from({length:4},(_,i)=>({id:`P${i+1}`,label:`Lugar de pie ${i+1}`,type:'standing'}))];
const KEY='palco-reservas-demo-v1'; let selected=[]; const $=id=>document.getElementById(id); const read=()=>{try{return JSON.parse(localStorage.getItem(KEY)||'[]')}catch{return[]}};
EVENTS.forEach(e=>$('event').add(new Option(`${e.name} · ${e.date}`,e.id)));
function people(){const e=$('executive').value.trim(),c=$('companions').value.split(/\n|,/).map(x=>x.trim()).filter(Boolean);return{executive:e,companions:c,count:e?1+c.length:0}}
function occupied(){return new Set(read().filter(r=>r.eventId===$('event').value).flatMap(r=>r.seats))}
function render(){const ev=EVENTS.find(e=>e.id===$('event').value),occ=occupied();$('eventName').textContent=ev.name;$('eventDate').textContent=ev.date;$('available').textContent=14-occ.size;$('attendees').textContent=people().count;$('selectedCount').textContent=selected.length;['chairs','standing'].forEach(id=>$(id).innerHTML='');SEATS.forEach(s=>{const b=document.createElement('button');b.className='seat'+(occ.has(s.id)?' booked':selected.includes(s.id)?' selected':'');b.textContent=s.label;b.disabled=occ.has(s.id);b.onclick=()=>{selected=selected.includes(s.id)?selected.filter(x=>x!==s.id):[...selected,s.id];render()};$(s.type==='chair'?'chairs':'standing').appendChild(b)})}
function message(t,ok=false){$('msg').textContent=t;$('msg').style.display='block';$('msg').className='msg'+(ok?' ok':'')}
$('event').onchange=()=>{selected=[];message('');$('msg').style.display='none';render()};$('executive').oninput=render;$('companions').oninput=render;
$('save').onclick=async()=>{const p=people(),occ=occupied(),ev=EVENTS.find(e=>e.id===$('event').value);if(!p.executive)return message('Completá el nombre del Ejecutivo.');if(!selected.length)return message('Seleccioná al menos una ubicación.');if(p.count!==selected.length)return message(`Hay ${p.count} asistente(s), pero seleccionaste ${selected.length} ubicación(es).`);if(selected.some(x=>occ.has(x)))return message('Una ubicación acaba de ser reservada. Actualizá la selección.');const reservation={id:crypto.randomUUID(),eventId:ev.id,eventName:ev.name,eventDate:ev.date,executiveName:p.executive,companions:p.companions,seats:selected,createdAt:new Date().toISOString(),status:'Confirmada'};
// PRODUCCION: reemplazar la persistencia local por fetch(POWER_AUTOMATE_URL,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(reservation)}).
const all=read();all.push(reservation);localStorage.setItem(KEY,JSON.stringify(all));$('executive').value='';$('companions').value='';selected=[];message('Reserva guardada correctamente.',true);render()};render();
</script></body></html>
